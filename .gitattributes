# Installers: install.sh must stay LF (piped to sh); install.ps1 keeps its
# committed CRLF bytes (repo PowerShell convention) on every checkout.
scripts/install.sh text eol=lf
scripts/test-install.sh text eol=lf
scripts/install.ps1 -text
scripts/test-install-windows.ps1 -text
scripts/banner.txt text eol=lf
# Stats fixtures are byte-exact (offsets, a deliberately unterminated last line).
internal/stats/testdata/** -text
# mcp goldens are compared byte for byte.
internal/mcp/testdata/** -text
# Dashboard assets are embedded byte for byte: LF on every checkout, so the
# 200 KB budget (D71) and release binaries match across OSes.
internal/gui/web/** text eol=lf
internal/gui/web/*.svg text eol=lf
